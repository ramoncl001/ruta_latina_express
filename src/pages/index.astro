<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Ruta Latina Express</title>
    <script is:inline>
      (function () {
        var lang = (navigator.language || 'es').toLowerCase();
        var target = lang.startsWith('en') ? '/en/' : '/es/';
        window.location.replace(target);
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/es/" />
    </noscript>
  </head>
  <body>
    <p>Redirecting… <a href="/es/">Español</a> | <a href="/en/">English</a></p>
  </body>
</html>
