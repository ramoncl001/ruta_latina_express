---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Seguimiento from '../../components/Seguimiento.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';
import { fetchContacts } from '../../lib/supabase';

const locale = 'es';
const contacts = await fetchContacts();
---

<Layout
  locale={locale}
  title="Seguimiento de envíos — Ruta Latina Express"
  description="Rastree su envío en tiempo real con el código que le compartimos. Seguimiento seguro y actualizado."
>
  <Nav locale={locale} />
  <main class="pt-16">
    <Seguimiento locale={locale} />
    <CTA locale={locale} contacts={contacts} />
  </main>
  <Footer locale={locale} contacts={contacts} />
</Layout>
