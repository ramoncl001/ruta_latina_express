---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import PricingCatalog from '../../components/PricingCatalog.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';
import { fetchContacts } from '../../lib/supabase';

const locale = 'es';
const contacts = await fetchContacts();
---

<Layout
  locale={locale}
  title="Precios — Ruta Latina Express"
  description="Catálogo de precios y cajas disponibles. Envíos por kilo, paquetes y cajas de distintos tamaños. Precios claros en USD."
>
  <Nav locale={locale} />
  <main class="pt-16">
    <PricingCatalog locale={locale} />
    <CTA locale={locale} contacts={contacts} />
  </main>
  <Footer locale={locale} contacts={contacts} />
</Layout>
