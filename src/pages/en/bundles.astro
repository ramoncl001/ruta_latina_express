---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Combos from '../../components/Combos.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';
import { fetchContacts } from '../../lib/supabase';

const locale = 'en';
const contacts = await fetchContacts();
---

<Layout
  locale={locale}
  title="Bundles — Ruta Latina Express"
  description="Choose the ideal bundle for your family: food, hygiene, and proteins. Transparent pricing, safe delivery to Cuba and South America."
>
  <Nav locale={locale} />
  <main class="pt-16">
    <Combos locale={locale} />
    <CTA locale={locale} contacts={contacts} />
  </main>
  <Footer locale={locale} contacts={contacts} />
</Layout>
