---
import type { PerPoundPrice, Locale } from '../lib/supabase';

interface Props {
  items: PerPoundPrice[];
  locale: Locale;
}

const { items, locale } = Astro.props;

const t = {
  empty:    locale === 'es' ? 'Aún no hay tarifas por libra para este destino.' : 'No per-pound rates available for this destination yet.',
  heading:  locale === 'es' ? 'Tarifas por libra' : 'Per-pound rates',
  perLb:    locale === 'es' ? 'por libra' : 'per pound',
};
---

<section class="py-12">
  <h2 class="font-display text-2xl md:text-3xl font-semibold text-[color:var(--color-ink)] mb-8 text-center">
    {t.heading}
  </h2>

  {items.length === 0 ? (
    <p class="text-[color:var(--color-graphite-500)] py-8 text-center">{t.empty}</p>
  ) : (
    <div class="flex flex-wrap justify-center gap-5">
      {items.map((item) => (
          <article class="group w-full sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.834rem)] rounded-2xl bg-white border border-[color:var(--color-rose-100)]/50 p-6 flex items-center gap-5 transition-shadow hover:shadow-[0_8px_24px_rgba(0,0,0,0.06)]">
            <div class="shrink-0 w-14 h-14 rounded-full bg-[color:var(--color-rose-50)] flex items-center justify-center text-[color:var(--color-pink)]">
              {item.svg_icon ? (
                <img src={item.svg_icon} alt="" loading="lazy" width="28" height="28" class="w-7 h-7 object-contain" />
              ) : (
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                  <path d="m3.3 7 8.7 5 8.7-5" />
                  <path d="M12 22V12" />
                </svg>
              )}
            </div>

            <div class="min-w-0 flex-1">
              <div class="font-medium text-[color:var(--color-ink)] truncate">{item.transport_medium}</div>
              <div class="mt-1 flex items-baseline gap-1">
                <span class="font-display text-2xl font-semibold gold-gradient-text">${item.price}</span>
                <span class="text-xs uppercase tracking-wider text-[color:var(--color-graphite-500)]">USD/lb</span>
              </div>
              <div class="text-xs text-[color:var(--color-graphite-500)]">{t.perLb}</div>
            </div>
          </article>
      ))}
    </div>
  )}
</section>
