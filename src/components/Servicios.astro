---
import { fetchServices, type Locale } from '../lib/supabase';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const services = await fetchServices(locale);

const SECTION_LABEL: Record<Locale, string> = {
  es: 'Servicios',
  en: 'Services',
};

const EMPTY_MESSAGE: Record<Locale, string> = {
  es: 'Estamos actualizando nuestros servicios. Vuelva pronto.',
  en: "We're updating our services. Please check back soon.",
};
---

<section id="servicios" class="relative overflow-hidden bg-[color:var(--color-white)]">
  {services.length === 0 ? (
    <div class="empty-state">
      <p class="empty-label">{SECTION_LABEL[locale]}</p>
      <p class="empty-message">{EMPTY_MESSAGE[locale]}</p>
    </div>
  ) : (
    <div class="carousel" data-carousel aria-label={`${SECTION_LABEL[locale]} — ${services.length}`}>
    <div class="track" data-track>
      {services.map((s, i) => (
        <div
          class="slide"
          data-index={i}
          role="group"
          aria-roledescription="slide"
          aria-label={`${SECTION_LABEL[locale]} ${i + 1} / ${services.length}: ${s.title}`}
        >
          <div class="slide-inner">
            <p class="slide-label">{SECTION_LABEL[locale]}</p>

            <div class="slide-media">
              {s.image_url && s.image_url !== '#'
                ? <img src={s.image_url} alt={s.title} loading="lazy" />
                : <span class="slide-media-fallback">{s.title.charAt(0)}</span>
              }
            </div>

            <h3 class="slide-title">{s.title}</h3>
            <p class="slide-desc">{s.description}</p>
          </div>
        </div>
      ))}
    </div>

    {services.length > 1 && (
      <>
        <button class="nav nav-prev" data-nav="prev" aria-label={locale === 'en' ? 'Previous service' : 'Servicio anterior'}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="nav nav-next" data-nav="next" aria-label={locale === 'en' ? 'Next service' : 'Servicio siguiente'}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <div class="dots" role="tablist" aria-label={SECTION_LABEL[locale]}>
          {services.map((_, i) => (
            <button
              role="tab"
              class="dot"
              data-dot={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`${locale === 'en' ? 'Go to service' : 'Ir al servicio'} ${i + 1}`}
            ></button>
          ))}
        </div>
      </>
    )}
  </div>
  )}
</section>

<style>
  .empty-state {
    min-height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem;
    gap: 1rem;
  }

  .empty-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    font-weight: 500;
  }

  .empty-message {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-graphite-500);
    max-width: 32rem;
    line-height: 1.7;
  }

  .carousel {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .track {
    display: flex;
    width: 100%;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      transition: none;
    }
  }

  .slide {
    flex: 0 0 100%;
    width: 100%;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
  }

  .slide-inner {
    max-width: 40rem;
    text-align: center;
  }

  .slide-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .slide-media {
    width: clamp(9rem, 22vw, 14rem);
    height: clamp(9rem, 22vw, 14rem);
    margin: 0 auto 2rem;
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--color-pink) 10%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .slide-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1.5rem;
  }

  .slide-media-fallback {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    color: var(--color-pink);
  }

  .slide-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .slide-desc {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--color-graphite-500);
    line-height: 1.7;
    max-width: 32rem;
    margin: 0 auto;
  }

  /* Nav buttons */
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: white;
    border: 1px solid color-mix(in srgb, var(--color-pink) 25%, transparent);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s, color 0.2s;
    z-index: 10;
  }

  .nav:hover {
    border-color: var(--color-pink);
    box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    color: var(--color-pink);
  }

  .nav svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .nav-prev { left: 1rem; }
  .nav-next { right: 1rem; }

  @media (min-width: 768px) {
    .nav-prev { left: 2rem; }
    .nav-next { right: 2rem; }
  }

  /* Dots */
  .dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 10;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--color-ink) 25%, transparent);
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
    padding: 0;
  }

  .dot[aria-selected="true"] {
    background: var(--color-pink);
    transform: scale(1.4);
  }
</style>

<script>
  const carousel = document.querySelector('#servicios [data-carousel]') as HTMLElement | null;
  if (carousel) {
    const track    = carousel.querySelector('[data-track]') as HTMLElement;
    const slides   = Array.from(carousel.querySelectorAll('[data-index]')) as HTMLElement[];
    const dots     = Array.from(carousel.querySelectorAll('[data-dot]')) as HTMLButtonElement[];
    const prevBtn  = carousel.querySelector('[data-nav="prev"]') as HTMLButtonElement | null;
    const nextBtn  = carousel.querySelector('[data-nav="next"]') as HTMLButtonElement | null;
    const total    = slides.length;
    let current    = 0;

    function goTo(index: number) {
      if (total === 0) return;
      current = (index + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        d.setAttribute('aria-selected', String(i === current));
      });
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Keyboard support — only when carousel is in viewport
    let inViewport = false;
    const observer = new IntersectionObserver(
      ([entry]) => { inViewport = entry.isIntersecting; },
      { threshold: 0.4 },
    );
    observer.observe(carousel);

    document.addEventListener('keydown', (e) => {
      if (!inViewport || total < 2) return;
      if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
    });

    // Touch swipe
    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', (e) => {
      if (total < 2) return;
      const delta = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(delta) > 40) {
        goTo(delta > 0 ? current + 1 : current - 1);
      }
    });

    goTo(0);
  }
</script>
