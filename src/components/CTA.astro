---
import { fetchPageContent, type Locale } from '../lib/supabase';

interface Props {
  contacts: Map<string, string>;
  locale?: Locale;
}
const { contacts, locale = 'es' } = Astro.props;

const copy = await fetchPageContent('cta', locale);

const FALLBACK: Record<Locale, Record<string, string>> = {
  es: {
    eyebrow:   'Empieza hoy',
    title:     '¿Listo para <span class="gold-gradient-text">enviar</span>?',
    body:      'Escríbenos por WhatsApp y te armamos una <strong>cotización personalizada</strong> en minutos. <strong>Sin compromiso</strong>, sin letra chica.',
    btn_wa:    'WhatsApp',
    btn_email: 'Escríbenos',
  },
  en: {
    eyebrow:   'Get started today',
    title:     'Ready to <span class="gold-gradient-text">ship</span>?',
    body:      'Message us on WhatsApp and we will put together a <strong>personalized quote</strong> in minutes. <strong>No commitment</strong>, no fine print.',
    btn_wa:    'WhatsApp',
    btn_email: 'Email us',
  },
};

const fb = FALLBACK[locale];
const g  = (key: string) => copy.get(key) ?? fb[key] ?? '';

const email    = contacts.get('email')    ?? '#';
const whatsapp = contacts.get('whatsapp') ?? '#';

const emailHref    = email    !== '#' ? `mailto:${email}`                 : '#';
const waDigits     = whatsapp !== '#' ? whatsapp.replace(/\D/g, '')       : '';
const whatsappHref = waDigits          ? `https://wa.me/${waDigits}`     : '#';
---

<section id="contacto" class="py-24 md:py-32">
  <div class="max-w-4xl mx-auto px-6">
    <div class="relative overflow-hidden rounded-3xl bg-[color:var(--color-ink)] p-12 md:p-16 text-center">
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-[color:var(--color-gold-500)]/20 blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-[color:var(--color-rose-300)]/20 blur-3xl translate-y-1/2 -translate-x-1/2"></div>

      <div class="relative">
        <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-gold-300)] font-medium">{g('eyebrow')}</p>
        <h2 class="mt-3 font-display text-4xl md:text-5xl font-semibold text-white" set:html={g('title')}></h2>
        <p class="mt-6 text-white/80 max-w-xl mx-auto" set:html={g('body')}></p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full text-sm font-medium text-[color:var(--color-graphite-900)] bg-white hover:bg-[color:var(--color-gold-300)] transition-colors shadow-lg"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <path d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043L8.23339 6.00894C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z" fill="currentColor"/>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z" fill="currentColor"/>
            </svg>
            {g('btn_wa')}
          </a>
          <a
            href={emailHref}
            class="px-8 py-3.5 rounded-full text-sm font-medium text-white border border-white/30 hover:border-[color:var(--color-gold-300)] hover:text-[color:var(--color-gold-300)] transition-colors"
          >
            {g('btn_email')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
