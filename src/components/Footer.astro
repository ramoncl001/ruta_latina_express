---
import type { Locale } from '../lib/supabase';

interface Props {
  contacts: Map<string, string>;
  locale?: Locale;
}
const { contacts, locale = 'es' } = Astro.props;

const year   = 2026;
const prefix = `/${locale}`;

const email     = contacts.get('email')     ?? '#';
const whatsapp  = contacts.get('whatsapp')  ?? '#';
const tiktok    = contacts.get('tiktok')    ?? '#';

const emailHref     = email     !== '#' ? `mailto:${email}`                       : '#';
const waDigits      = whatsapp  !== '#' ? whatsapp.replace(/\D/g, '')             : '';
const whatsappHref  = waDigits           ? `https://wa.me/${waDigits}`            : '#';
const tiktokHref    = tiktok    !== '#' ? `https://www.tiktok.com/@${tiktok.replace(/^@/, '')}` : '#';

const COPY: Record<Locale, {
  tagline: string;
  col_about: string; lnk_about: string; lnk_contact: string; lnk_destinations: string;
  col_contact: string; lnk_email: string; lnk_wa: string; lnk_tk: string;
  copyright: string;
}> = {
  es: {
    tagline:          'Envíos de alimentos, medicinas y paquetes a Cuba y Sudamérica.',
    col_about:        'Nosotros',
    lnk_about:        'Quiénes somos', lnk_contact: 'Contacto', lnk_destinations: 'Destinos',
    col_contact:      'Contacto',
    lnk_email:        'Correo electrónico', lnk_wa: 'WhatsApp', lnk_tk: 'TikTok',
    copyright:        `© ${year} Ruta Latina Express. Todos los derechos reservados.`,
  },
  en: {
    tagline:          'Food, medicine, and package shipments to Cuba and South America.',
    col_about:        'About',
    lnk_about:        'Who we are', lnk_contact: 'Contact', lnk_destinations: 'Destinations',
    col_contact:      'Contact',
    lnk_email:        'Email', lnk_wa: 'WhatsApp', lnk_tk: 'TikTok',
    copyright:        `© ${year} Ruta Latina Express. All rights reserved.`,
  },
};

const t = COPY[locale];
---

<footer class="bg-[color:var(--color-ink)] text-gray-300 pt-16 pb-8">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Logo row -->
    <div class="mb-12">
      <div class="flex items-center gap-3">
        <img src="/logo.svg" alt="Ruta Latina Express" class="h-12 w-auto bg-white rounded-full p-1" width="60" height="48" />
        <span class="font-semibold text-white text-lg">Ruta Latina Express</span>
      </div>
      <p class="mt-3 text-sm text-gray-300 max-w-xs">{t.tagline}</p>
    </div>

    <!-- 2-column grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 border-t border-white/10 pt-10">

      <!-- About -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.15em] text-white font-medium mb-4">{t.col_about}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${prefix}#quienes-somos`} class="text-gray-300 hover:text-white transition-colors">{t.lnk_about}</a></li>
          <li><a href={`${prefix}#contacto`}       class="text-gray-300 hover:text-white transition-colors">{t.lnk_contact}</a></li>
          <li><a href={`${prefix}#destinos`}        class="text-gray-300 hover:text-white transition-colors">{t.lnk_destinations}</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.15em] text-white font-medium mb-4">{t.col_contact}</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={emailHref} class="inline-flex items-center gap-2 text-gray-300 hover:text-white transition-colors">
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 7.00005L10.2 11.65C11.2667 12.45 12.7333 12.45 13.8 11.65L20 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              {t.lnk_email}
            </a>
          </li>
          <li>
            <a href={whatsappHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-gray-300 hover:text-white transition-colors">
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.014 8.00613C6.12827 7.1024 7.30277 5.87414 8.23488 6.01043L8.23339 6.00894C9.14051 6.18132 9.85859 7.74261 10.2635 8.44465C10.5504 8.95402 10.3641 9.4701 10.0965 9.68787C9.7355 9.97883 9.17099 10.3803 9.28943 10.7834C9.5 11.5 12 14 13.2296 14.7107C13.695 14.9797 14.0325 14.2702 14.3207 13.9067C14.5301 13.6271 15.0466 13.46 15.5548 13.736C16.3138 14.178 17.0288 14.6917 17.69 15.27C18.0202 15.546 18.0977 15.9539 17.8689 16.385C17.4659 17.1443 16.3003 18.1456 15.4542 17.9421C13.9764 17.5868 8 15.27 6.08033 8.55801C5.97237 8.24048 5.99955 8.12044 6.014 8.00613Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 23C10.7764 23 10.0994 22.8687 9 22.5L6.89443 23.5528C5.56462 24.2177 4 23.2507 4 21.7639V19.5C1.84655 17.492 1 15.1767 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12C23 18.0751 18.0751 23 12 23ZM6 18.6303L5.36395 18.0372C3.69087 16.4772 3 14.7331 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C11.0143 21 10.552 20.911 9.63595 20.6038L8.84847 20.3397L6 21.7639V18.6303Z" fill="currentColor"/>
              </svg>
              {t.lnk_wa}
            </a>
          </li>
          <li>
            <a href={tiktokHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-gray-300 hover:text-white transition-colors">
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M16.656 1.029c1.637-0.025 3.262-0.012 4.886-0.025 0.054 2.031 0.878 3.859 2.189 5.213l-0.002-0.002c1.411 1.271 3.247 2.095 5.271 2.235l0.028 0.002v5.036c-1.912-0.048-3.71-0.489-5.331-1.247l0.082 0.034c-0.784-0.377-1.447-0.764-2.077-1.196l0.052 0.034c-0.012 3.649 0.012 7.298-0.025 10.934-0.103 1.853-0.719 3.543-1.707 4.954l0.020-0.031c-1.652 2.366-4.328 3.919-7.371 4.011l-0.014 0c-0.123 0.006-0.268 0.009-0.414 0.009-1.73 0-3.347-0.482-4.725-1.319l0.040 0.023c-2.508-1.509-4.238-4.091-4.558-7.094l-0.004-0.041c-0.025-0.625-0.037-1.25-0.012-1.862 0.49-4.779 4.494-8.476 9.361-8.476 0.547 0 1.083 0.047 1.604 0.136l-0.056-0.008c0.025 1.849-0.050 3.699-0.050 5.548-0.423-0.153-0.911-0.242-1.42-0.242-1.868 0-3.457 1.194-4.045 2.861l-0.009 0.030c-0.133 0.427-0.21 0.918-0.21 1.426 0 0.206 0.013 0.41 0.037 0.61l-0.002-0.024c0.332 2.046 2.086 3.59 4.201 3.59 0.061 0 0.121-0.001 0.181-0.004l-0.009 0c1.463-0.044 2.733-0.831 3.451-1.994l0.010-0.018c0.267-0.372 0.45-0.822 0.511-1.311l0.001-0.014c0.125-2.237 0.075-4.461 0.087-6.698 0.012-5.036-0.012-10.060 0.025-15.083z"/>
              </svg>
              {t.lnk_tk}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Copyright row -->
    <div class="mt-10 pt-6 border-t border-white/10 text-center text-xs text-gray-400">
      {t.copyright}
    </div>

  </div>
</footer>
