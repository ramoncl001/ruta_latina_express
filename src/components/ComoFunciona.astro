---
import { fetchPageContent, type Locale } from '../lib/supabase';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const copy = await fetchPageContent('como_funciona', locale);

// All page copy comes from Supabase (section 'como_funciona'). Missing keys
// render nothing. Empty state message stays hardcoded (UI concern, not copy).
const g = (key: string): string => copy.get(key) ?? '';

const emptyMessage = locale === 'es'
  ? 'Estamos actualizando esta sección. Vuelva pronto.'
  : "We're updating this section. Please check back soon.";

const rawSteps = [1, 2, 3, 4].map((n) => ({
  n:     g(`step_${n}_n`),
  title: g(`step_${n}_title`),
  desc:  g(`step_${n}_desc`),
}));

// Only render steps that have at least a title (avoid orphan empty cards).
const steps     = rawSteps.filter((s) => s.title);
const titleText = g('title');
---

<section id="como-funciona" class="py-24 md:py-32 bg-[color:var(--color-cream)]">
  <div class="max-w-6xl mx-auto px-6">
    {(g('eyebrow') || titleText) && (
      <div class="text-center max-w-2xl mx-auto mb-16">
        {g('eyebrow') && <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-gold)] font-medium">{g('eyebrow')}</p>}
        {titleText && (
          <h2
            class="mt-3 font-display text-4xl md:text-5xl font-semibold text-[color:var(--color-ink)]"
            set:html={titleText}
          ></h2>
        )}
        <div class="gold-line w-24 mx-auto mt-6"></div>
      </div>
    )}

    {steps.length === 0 ? (
      <p class="text-center text-[color:var(--color-graphite-500)] max-w-lg mx-auto py-12">{emptyMessage}</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {steps.map((s) => (
          <div class="relative p-8 rounded-2xl bg-white border border-[color:var(--color-rose-100)]/50">
            {s.n && <div class="font-display text-6xl font-semibold gold-gradient-text mb-3">{s.n}</div>}
            <h3 class="font-display text-xl font-semibold text-[color:var(--color-ink)] mb-2">{s.title}</h3>
            {s.desc && <p class="text-sm text-[color:var(--color-graphite-500)] leading-relaxed" set:html={s.desc}></p>}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
