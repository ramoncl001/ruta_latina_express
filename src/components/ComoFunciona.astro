---
import { fetchPageContent, type Locale } from '../lib/supabase';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const copy = await fetchPageContent('como_funciona', locale);

const FALLBACK: Record<Locale, Record<string, string>> = {
  es: {
    eyebrow:      'Cómo funciona',
    title:        'Cuatro pasos, <span class="gold-gradient-text">cero complicaciones</span>',
    step_1_n:     '01', step_1_title: 'Cotiza tu envío',   step_1_desc: 'Selecciona el <strong>combo</strong> o cotiza un envío personalizado según peso y destino.',
    step_2_n:     '02', step_2_title: 'Elige tu opción',   step_2_desc: 'Revisa los precios y elige el combo o servicio que mejor se adapte a tu familia.',
    step_3_n:     '03', step_3_title: 'Confirma y paga',   step_3_desc: 'Coordinamos por WhatsApp. Aceptamos transferencia, tarjeta y efectivo.',
    step_4_n:     '04', step_4_title: 'Recibe el envío',   step_4_desc: 'Te compartimos el código de <span class="hl-gold">seguimiento</span> hasta la entrega final.',
  },
  en: {
    eyebrow:      'How it works',
    title:        'Four steps, <span class="gold-gradient-text">zero hassle</span>',
    step_1_n:     '01', step_1_title: 'Get a quote',           step_1_desc: 'Select a <strong>bundle</strong> or request a custom quote based on weight and destination.',
    step_2_n:     '02', step_2_title: 'Choose your option',    step_2_desc: 'Review prices and choose the bundle or service that best suits your family.',
    step_3_n:     '03', step_3_title: 'Confirm and pay',       step_3_desc: 'We coordinate via WhatsApp. We accept bank transfer, card, and cash.',
    step_4_n:     '04', step_4_title: 'Receive your shipment', step_4_desc: 'We share the <span class="hl-gold">tracking</span> code with you until final delivery.',
  },
};

const fb = FALLBACK[locale];
const g  = (key: string) => copy.get(key) ?? fb[key] ?? '';

const steps = [1, 2, 3, 4].map((n) => ({
  n:     g(`step_${n}_n`),
  title: g(`step_${n}_title`),
  desc:  g(`step_${n}_desc`),
}));
---

<section id="como-funciona" class="py-24 md:py-32 bg-[color:var(--color-cream)]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-gold)] font-medium">{g('eyebrow')}</p>
      <h2
        class="mt-3 font-display text-4xl md:text-5xl font-semibold text-[color:var(--color-ink)]"
        set:html={g('title')}
      ></h2>
      <div class="gold-line w-24 mx-auto mt-6"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((s) => (
        <div class="relative p-8 rounded-2xl bg-white border border-[color:var(--color-rose-100)]/50">
          <div class="font-display text-6xl font-semibold gold-gradient-text mb-3">{s.n}</div>
          <h3 class="font-display text-xl font-semibold text-[color:var(--color-ink)] mb-2">{s.title}</h3>
          <p class="text-sm text-[color:var(--color-graphite-500)] leading-relaxed" set:html={s.desc}></p>
        </div>
      ))}
    </div>
  </div>
</section>
