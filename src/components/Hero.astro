---
import { fetchPageContent, type Locale } from '../lib/supabase';
import { Image } from 'astro:assets';
import heroFamily from '../assets/hero-family.webp';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const copy = await fetchPageContent('hero', locale);

// Hardcoded fallbacks (used when page_content table is empty / SQL not yet run)
const FALLBACK: Record<Locale, Record<string, string>> = {
  es: {
    badge:          'Envíos a Cuba y Sudamérica',
    title_line1:    'Conectamos familias,',
    title_line2:    'envío tras envío.',
    subtitle:       'Enviamos alimentos, medicinas y paquetes con <span class="hl-gold">seguimiento en tiempo real</span>. <strong>Precios transparentes</strong>, <strong>entrega puerta a puerta</strong>, atención humana.',
    cta_primary:    'Ver combos y precios',
    cta_secondary:  'Cómo funciona',
    badge_tracking: 'Seguimiento en línea',
    badge_delivery: 'Entrega puerta a puerta'
  },
  en: {
    badge:          'Shipping to Cuba & South America',
    title_line1:    'Connecting families,',
    title_line2:    'shipment after shipment.',
    subtitle:       'We ship food, medicine, and packages with <span class="hl-gold">real-time tracking</span>. <strong>Transparent pricing</strong>, <strong>door-to-door delivery</strong>, human support.',
    cta_primary:    'View bundles & prices',
    cta_secondary:  'How it works',
    badge_tracking: 'Online tracking',
    badge_delivery: 'Door-to-door delivery'
  },
};

const fb = FALLBACK[locale];
const g  = (key: string) => copy.get(key) ?? fb[key] ?? '';

const prefix = `/${locale}`;
---

<section class="relative overflow-hidden bg-[color:var(--color-white)]">
  <div class="grid grid-cols-1 md:grid-cols-[45%_55%] items-stretch">

    <!-- Image column (left) — clearly visible, soft fade only on its right edge -->
    <div class="relative order-1 h-64 sm:h-80 md:h-auto md:min-h-[calc(100vh-4rem)]">
      <Image
        src={heroFamily}
        alt="Repartidor de Ruta Latina Express entregando una caja a una familia"
        widths={[640, 900, 1200]}
        sizes="(max-width: 767px) 100vw, 45vw"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
      />
      <!-- Thin fade so the image blends into the white text side without a hard seam -->
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b md:bg-gradient-to-r from-transparent via-transparent to-[color:var(--color-white)]"></div>
    </div>

    <!-- Text column (right) — sits on clean white, never over the image -->
    <div class="order-2 flex flex-col justify-center text-center md:text-left px-6 md:px-12 lg:px-16 py-12 md:py-20">
      <img
        src="/logo.svg"
        alt="Ruta Latina Express"
        class="mx-auto md:mx-0 mb-8 h-28 md:h-36 w-auto"
        width="240"
        height="160"
      />

      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase text-[color:var(--color-pink)] bg-[color:var(--color-pink)]/10 border border-[color:var(--color-pink)]/20 mx-auto md:mx-0 w-fit">
        <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-gold)]"></span>
        {g('badge')}
      </span>

      <h1 class="mt-6 font-display text-4xl md:text-6xl font-semibold leading-[1.05] text-[color:var(--color-graphite-900)]">
        {g('title_line1')}<br />
        <span class="gold-gradient-text">{g('title_line2')}</span>
      </h1>

      <p class="mt-6 max-w-xl mx-auto md:mx-0 text-lg text-[color:var(--color-graphite-500)] leading-relaxed" set:html={g('subtitle')}></p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a href={`${prefix}#como-funciona`} class="px-8 py-3.5 rounded-full text-sm font-medium text-[color:var(--color-graphite-700)] border border-[color:var(--color-graphite-500)]/20 hover:border-[color:var(--color-gold-500)] hover:text-[color:var(--color-gold-700)] transition-colors">
          {g('cta_secondary')}
        </a>
      </div>

      <div class="mt-12 flex flex-wrap justify-center md:justify-start gap-x-10 gap-y-4 text-sm text-[color:var(--color-graphite-500)]">
        <div class="flex items-center gap-2">
          <span class="text-[color:var(--color-gold-500)]">✦</span>
          {g('badge_tracking')}
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[color:var(--color-gold-500)]">✦</span>
          {g('badge_delivery')}
        </div>
      </div>
    </div>

  </div>
</section>
