---
import type { SpecialContent, Locale } from '../lib/supabase';

interface Props {
  items: SpecialContent[];
  locale: Locale;
}

const { items, locale } = Astro.props;

const COPY: Record<Locale, { eyebrow: string; heading: string; prev: string; next: string }> = {
  es: {
    eyebrow: 'Promociones especiales',
    heading: 'Ofertas destacadas',
    prev:    'Promoción anterior',
    next:    'Promoción siguiente',
  },
  en: {
    eyebrow: 'Special promotions',
    heading: 'Featured offers',
    prev:    'Previous promotion',
    next:    'Next promotion',
  },
};

const t = COPY[locale];
---

{items.length > 0 && (
  <section class="py-12 special-promos">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-pink)] font-semibold">{t.eyebrow}</p>
      <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold text-[color:var(--color-ink)]">
        {t.heading}
      </h2>
    </div>

    <div class="relative sp-carousel" data-special-carousel>
      <div class="sp-viewport" data-viewport>
        <div class="sp-track" data-track>
          {items.map((block) => (
            <article class="sp-jumbotron" data-sp-id={block.id}>
              <div class="sp-jumbotron-inner">
                <h3 class="font-display text-3xl md:text-5xl font-bold mb-5 leading-tight">
                  {block.title}
                </h3>
                {block.description && (
                  <p class="sp-desc text-xl md:text-2xl leading-relaxed max-w-3xl mx-auto" set:html={block.description}></p>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>

      {items.length > 1 && (
        <>
          <button class="sp-nav sp-nav-prev" data-nav="prev" aria-label={t.prev}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="sp-nav sp-nav-next" data-nav="next" aria-label={t.next}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>

          <div class="sp-dots" role="tablist" data-dots-container></div>
        </>
      )}
    </div>
  </section>
)}

<style is:global>
  .special-promos .sp-viewport {
    overflow: hidden;
    border-radius: 1.5rem;
  }

  .special-promos .sp-track {
    display: flex;
    gap: 0;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .special-promos .sp-track {
      transition: none;
    }
  }

  /* Jumbotron — one full-width promotional block at a time */
  .special-promos .sp-jumbotron {
    flex-shrink: 0;
    flex-basis: 100%;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, var(--color-pink) 0%, #C70A54 100%);
    color: white;
    min-height: 20rem;
  }

  @media (min-width: 768px) {
    .special-promos .sp-jumbotron {
      padding: 5rem 3rem;
      min-height: 24rem;
    }
  }

  .special-promos .sp-jumbotron-inner {
    width: 100%;
  }

  /* Description highlights (bold/pink accents authored in the DB) stay readable on the pink bg */
  .special-promos .sp-desc strong {
    font-weight: 800;
  }

  /* Nav buttons */
  .special-promos .sp-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: white;
    border: 1px solid color-mix(in srgb, var(--color-pink) 25%, transparent);
    color: var(--color-pink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s, color 0.2s;
    z-index: 10;
  }

  .special-promos .sp-nav:hover {
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  }

  .special-promos .sp-nav svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .special-promos .sp-nav-prev { left: 1rem; }
  .special-promos .sp-nav-next { right: 1rem; }

  @media (min-width: 768px) {
    .special-promos .sp-nav-prev { left: 1.5rem; }
    .special-promos .sp-nav-next { right: 1.5rem; }
  }

  /* Dots */
  .special-promos .sp-dots {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .special-promos .sp-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--color-ink) 20%, transparent);
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
    padding: 0;
  }

  .special-promos .sp-dot[aria-selected="true"] {
    background: var(--color-pink);
    transform: scale(1.4);
  }
</style>

<script>
  const root = document.querySelector('[data-special-carousel]') as HTMLElement | null;
  if (root) {
    const viewport = root.querySelector('[data-viewport]') as HTMLElement | null;
    const track    = root.querySelector('[data-track]') as HTMLElement | null;
    const cards    = Array.from(root.querySelectorAll<HTMLElement>('.sp-jumbotron'));
    const prevBtn  = root.querySelector('[data-nav="prev"]') as HTMLButtonElement | null;
    const nextBtn  = root.querySelector('[data-nav="next"]') as HTMLButtonElement | null;
    const dotsBox  = root.querySelector('[data-dots-container]') as HTMLElement | null;
    const total    = cards.length;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTOPLAY_MS = 6000;

    if (viewport && track && total > 0) {
      let current = 0;
      let autoplayTimer: number | undefined;

      // Jumbotron: always one full-width block per view.

      function renderDots() {
        if (!dotsBox) return;
        dotsBox.innerHTML = '';
        for (let i = 0; i < total; i++) {
          const dot = document.createElement('button');
          dot.className = 'sp-dot';
          dot.setAttribute('role', 'tab');
          dot.setAttribute('aria-selected', String(i === 0));
          dot.setAttribute('aria-label', `${i + 1}`);
          dot.addEventListener('click', () => { goTo(i); restartAutoplay(); });
          dotsBox.appendChild(dot);
        }
      }

      function goTo(index: number) {
        // Wrap around for a continuous autoplay loop
        if (index >= total) current = 0;
        else if (index < 0) current = total - 1;
        else current = index;

        track!.style.transform = `translateX(-${current * 100}%)`;
        updateChrome();
      }

      function updateChrome() {
        if (dotsBox) {
          Array.from(dotsBox.children).forEach((d, i) => {
            (d as HTMLElement).setAttribute('aria-selected', String(i === current));
          });
        }
      }

      function stopAutoplay() {
        if (autoplayTimer !== undefined) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = undefined;
        }
      }

      function startAutoplay() {
        if (reduceMotion || total < 2) return;
        stopAutoplay();
        autoplayTimer = window.setInterval(() => goTo(current + 1), AUTOPLAY_MS);
      }

      function restartAutoplay() {
        startAutoplay();
      }

      prevBtn?.addEventListener('click', () => { goTo(current - 1); restartAutoplay(); });
      nextBtn?.addEventListener('click', () => { goTo(current + 1); restartAutoplay(); });

      // Pause on hover / touch interaction
      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);

      let inViewport = false;
      const observer = new IntersectionObserver(
        ([entry]) => {
          inViewport = entry.isIntersecting;
          if (inViewport) startAutoplay();
          else stopAutoplay();
        },
        { threshold: 0.3 },
      );
      observer.observe(root);

      document.addEventListener('keydown', (e) => {
        if (!inViewport || total < 2) return;
        if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(current - 1); restartAutoplay(); }
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); restartAutoplay(); }
      });

      let touchStartX = 0;
      viewport.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        stopAutoplay();
      }, { passive: true });
      viewport.addEventListener('touchend', (e) => {
        if (total >= 2) {
          const delta = touchStartX - e.changedTouches[0].clientX;
          if (Math.abs(delta) > 40) {
            goTo(delta > 0 ? current + 1 : current - 1);
          }
        }
        startAutoplay();
      });

      renderDots();
      goTo(0);
      startAutoplay();
    }
  }
</script>
