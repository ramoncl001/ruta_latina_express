---
import { fetchCountries, type Locale } from '../lib/supabase';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const countries = await fetchCountries(locale);

const COPY: Record<Locale, { eyebrow: string; title: string; titleHighlight: string; empty: string }> = {
  es: {
    eyebrow:        'Destinos',
    title:          'Enviamos a ',
    titleHighlight: 'toda Latinoamérica',
    empty:          'Estamos actualizando nuestros destinos. Vuelva pronto.',
  },
  en: {
    eyebrow:        'Destinations',
    title:          'We ship across ',
    titleHighlight: 'Latin America',
    empty:          "We're updating our destinations. Please check back soon.",
  },
};

const t = COPY[locale];
---

<section id="destinos" class="py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-gold-700)] font-medium">{t.eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl md:text-5xl font-semibold text-[color:var(--color-graphite-900)]">
        {t.title}<span class="gold-gradient-text">{t.titleHighlight}</span>
      </h2>
      <div class="gold-line w-24 mx-auto mt-6"></div>
    </div>

    {countries.length === 0 ? (
      <p class="text-center text-[color:var(--color-graphite-500)] max-w-lg mx-auto py-12">{t.empty}</p>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {countries.map((c) => {
          const cardClass = "group p-6 rounded-2xl bg-white border border-[color:var(--color-rose-100)]/50 hover:border-[color:var(--color-gold-300)] hover:shadow-md text-center transition-all duration-300";
          const inner = (
            <>
              <div class="text-4xl mb-2 group-hover:scale-110 transition-transform">{c.flag}</div>
              <h3 class="font-display text-lg font-semibold text-[color:var(--color-graphite-900)]">{c.name}</h3>
            </>
          );
          return c.slug
            ? <a href={`/${locale}/${c.slug}`} class={cardClass}>{inner}</a>
            : <div class={cardClass}>{inner}</div>;
        })}
      </div>
    )}
  </div>
</section>
