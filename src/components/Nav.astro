---
import type { Locale } from '../lib/supabase';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const prefix = `/${locale}`;

const NAV_LABELS: Record<Locale, { services: string; destinations: string; bundles: string; how: string; contact: string; tracking: string; cta: string }> = {
  es: { services: 'Servicios', destinations: 'Destinos', bundles: 'Combos', how: 'Cómo funciona', contact: 'Contacto', tracking: 'Rastrear envío', cta: 'Cotizar envío' },
  en: { services: 'Services',  destinations: 'Destinations', bundles: 'Bundles', how: 'How it works', contact: 'Contact', tracking: 'Track shipment', cta: 'Get a quote' },
};

const t = NAV_LABELS[locale];

const links = [
  { href: `${prefix}#servicios`,     label: t.services },
  { href: `${prefix}#destinos`,      label: t.destinations },
  { href: `${prefix}#combos`,        label: t.bundles },
  { href: `${prefix}#como-funciona`, label: t.how },
  { href: `${prefix}#contacto`,      label: t.contact },
  { href: `${prefix}#seguimiento`,   label: t.tracking },
];
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-[color:var(--color-pearl)]/80 border-b border-[color:var(--color-rose-100)]/60">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={prefix} class="flex items-center gap-3">
      <img src="/logo.svg" alt="Ruta Latina Express" class="h-10 w-auto" width="60" height="40" />
      <span class="font-semibold text-lg text-[color:var(--color-ink)] tracking-tight hidden sm:inline">
        Ruta Latina <span class="text-[color:var(--color-pink)]">Express</span>
      </span>
    </a>
    <ul class="hidden md:flex items-center gap-8 text-sm">
      {links.map((l) => (
        <li>
          <a href={l.href} class="text-[color:var(--color-graphite-500)] hover:text-[color:var(--color-rose-700)] transition-colors">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href={`${prefix}#contacto`}
      class="hidden md:inline-flex items-center gap-2 px-5 py-2 rounded-full text-sm font-medium text-white bg-[color:var(--color-graphite-900)] hover:bg-[color:var(--color-rose-700)] transition-colors shadow-sm"
    >
      {t.cta}
    </a>
  </nav>
</header>
