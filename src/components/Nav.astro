---
import type { Locale } from '../lib/supabase';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const prefix = `/${locale}`;

// Nav is minimal: logo on the left, quote CTA on the right. Section links
// were removed intentionally.
const NAV_LABELS: Record<Locale, { cta: string }> = {
  es: { cta: 'Cotizar envío' },
  en: { cta: 'Get a quote' },
};

const t = NAV_LABELS[locale];
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-[color:var(--color-pearl)]/80 border-b border-[color:var(--color-rose-100)]/60">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={prefix} class="flex items-center gap-3">
      <img src="/logo.svg" alt="Ruta Latina Express" class="h-10 w-auto" width="60" height="40" />
      <span class="font-semibold text-lg text-[color:var(--color-ink)] tracking-tight hidden sm:inline">
        Ruta Latina <span class="text-[color:var(--color-pink)]">Express</span>
      </span>
    </a>
    <a
      href={`${prefix}/#contacto`}
      class="inline-flex items-center gap-2 px-5 py-2 rounded-full text-sm font-medium text-white bg-[color:var(--color-graphite-900)] hover:bg-[color:var(--color-rose-700)] transition-colors shadow-sm"
    >
      {t.cta}
    </a>
  </nav>
</header>
